# Travel Corner — environment configuration for independent hosting.
# Copy to .env for local development, or set these in the host's dashboard.
# Placeholders only: never commit real values. .env is already gitignored.

# ---------------------------------------------------------------------------
# Database — a fresh MySQL 8 database. Apply the committed migrations with
#   pnpm db:migrate
# Do NOT run `pnpm db:push`: it runs `drizzle-kit generate` first and would
# author new migration files instead of applying the existing ones.
#
# The server must run at UTC and the database must use utf8mb4, or the Arabic
# content and the TIMESTAMP validity windows will not round-trip correctly.
# Append ?ssl={"minVersion":"TLSv1.2","rejectUnauthorized":true} (URL-encoded)
# for a managed database that requires TLS. A bare ?ssl=true is rejected by the
# driver — the value must be a JSON object.
DATABASE_URL=mysql://user:password@host:3306/travelcorner

# CA certificate for a managed MySQL that requires TLS verification (Aiven).
# This is a PATH to a PEM file; the certificate CONTENT is read from it at
# startup. On Render, add the CA as a Secret File named aiven-ca.pem and it is
# mounted at the path below. See docs/deployment-render-aiven.md.
#
# When set, the connection requires TLS >= 1.2, verifies the server against this
# CA, and verifies that the certificate was issued for the hostname in
# DATABASE_URL. If the file is missing, unreadable, empty or not a valid
# certificate, the app FAILS TO START rather than connecting unverified.
#
# DATABASE_URL must address the server by hostname, not by IP: the driver cannot
# check certificate identity against an IP, so that combination is refused.
# Leave it unset for local development, which connects in plaintext.
#
# Do NOT put ssl-mode=REQUIRED (or sslmode, ssl-ca, useSSL, …) in DATABASE_URL:
# the driver ignores those spellings and would downgrade to plaintext, so the app
# now refuses to start if it finds one.
# DATABASE_CA_PATH=/etc/secrets/aiven-ca.pem

# ---------------------------------------------------------------------------
# Sessions and administrator login
#
# JWT_SECRET signs the session cookie. Generate a FRESH value for the new
# deployment — do not reuse the Manus one:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string

# Stable identifier for the single administrator account. Any opaque, non-guessable
# string; it is server configuration, never accepted from a request. Read the same way as
# ADMIN_PASSWORD_HASH (surrounding whitespace and quotes removed), because a newline here would
# write one openId to the database and sign a different one into the session cookie.
OWNER_OPEN_ID=replace-with-an-opaque-admin-identifier

# scrypt hash of the administrator password. Generate with:
#   pnpm admin:hash
# Store only the hash. The password itself is never persisted or logged.
# Format: scrypt$N$r$p$<salt-base64>$<hash-base64>
#
# Paste the whole value on one line, with no surrounding quotes. The server removes surrounding
# whitespace and one matching pair of quotes, so the two usual paste accidents are tolerated — but
# a value damaged any other way (truncated, or quoted on one side only) is refused as a
# *configuration* fault: the login answers 503 "not configured" and the log says which part of the
# digest is unreadable. It no longer answers "Incorrect password." for a hash problem, which is
# what made a mangled paste indistinguishable from a wrong password.
#
# Each password and hash are one pair. Generating a new hash invalidates the previous password, so
# if you run `pnpm admin:hash` more than once, keep the password from the SAME run as the hash you
# deploy and discard the others.
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$replace-salt-base64$replace-hash-base64

# Identifier embedded in the session cookie and checked when it is verified.
# Required: an empty value makes every issued session invalid. Any stable,
# non-empty string will do off-platform; changing it signs the administrator out.
VITE_APP_ID=travel-corner

# Session cookie SameSite policy. Defaults to "lax", which keeps the admin
# mutations protected against cross-site requests. Only set "none" if the app
# must be embedded cross-site in an iframe; "none" also requires HTTPS.
# SESSION_COOKIE_SAMESITE=lax

# How many reverse proxies sit between a client and this process. It decides how
# the administrator-login rate limiter identifies a client.
#
# X-Forwarded-For is append-only, so only the right-hand entries are written by
# infrastructure you control. This value says how many of them to trust.
#   0 (default) — ignore the header entirely and key on the socket address. A
#                 client cannot forge that, so the 5-failure lockout cannot be
#                 bypassed. OPERATIONAL LIMIT: behind any proxy every client then
#                 shares one bucket, so five wrong passwords from anyone lock the
#                 administrator out for 15 minutes. Availability only — it never
#                 grants access.
#   1           — correct behind a single proxy such as Railway's edge, and
#                 restores per-client limiting. Only set it once you have
#                 confirmed the hop count: if it is higher than the real number
#                 of proxies, the entry read is caller-supplied again.
# Verify with: log X-Forwarded-For on a request to the deployed URL and count the
# entries appended by the platform.
# TRUSTED_PROXY_HOPS=0

# ---------------------------------------------------------------------------
# Optional: Umami analytics. BOTH are read at BUILD time and baked into the
# HTML. Leave them unset and the analytics tag is removed from the built page
# entirely; set both and it ships as before. Setting only one is treated as
# unset, because a half-substituted tag would request a broken URL.
# VITE_ANALYTICS_ENDPOINT=
# VITE_ANALYTICS_WEBSITE_ID=

# ---------------------------------------------------------------------------
# Runtime
NODE_ENV=production
# PORT is injected by most hosts. In production the server binds exactly this
# port and fails loudly rather than silently choosing another.
# PORT=3000

# ---------------------------------------------------------------------------
# Media storage — Cloudflare R2 (S3-compatible). See docs/media-storage.md.
#
# When these are set, administrator image uploads go to R2 and both /media/* and
# the legacy /manus-storage/* route resolve from R2 — nothing on the media path
# contacts Manus Forge. While they are unset the media route falls back to Forge,
# and answers 503 if Forge is unset too — logging "no media backend configured"
# once per process, not once per request.
#
# While they are unset the admin dashboard also says so on the hotel package form
# and disables the upload buttons, rather than letting an upload be chosen and
# then fail. Everything else about a package stays editable.
#
# The account id derives the endpoint https://<id>.r2.cloudflarestorage.com.
# R2_ENDPOINT overrides it if ever needed.
# R2_ACCOUNT_ID=replace-with-the-cloudflare-account-id
# R2_ENDPOINT=
# R2_BUCKET=travel-corner-media

# R2 API token scoped to that bucket, with object read and write. The secret is
# shown once by Cloudflare; store it in the host's dashboard, never in the repo.
# R2_ACCESS_KEY_ID=replace-with-the-r2-access-key-id
# R2_SECRET_ACCESS_KEY=replace-with-the-r2-secret-access-key

# Public bucket URL (an r2.dev subdomain or a custom domain), WITHOUT a trailing
# slash. Set it for a public bucket and image URLs point straight at it. Leave it
# unset for a private bucket: the app then redirects to a 15-minute signed GET.
# R2_PUBLIC_BASE_URL=

# NOTE: the nine static brand and editorial images are not in this repository and
# are not in R2 either. They must be recovered from Manus storage and uploaded
# under the same keys before they will load. docs/media-storage.md lists them.

# ---------------------------------------------------------------------------
# Optional: Manus Forge. Still used by AI image generation, and as the media
# fallback until the R2 variables above are set. Leave unset off-platform.
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=

# ---------------------------------------------------------------------------
# Legacy Manus OAuth. Not required for password login; leave unset off-platform.
# VITE_APP_ID is NOT part of this block — see the sessions section above.
# OAUTH_SERVER_URL=
# VITE_OAUTH_PORTAL_URL=

# ---------------------------------------------------------------------------
# Integration tests only. Must point at a DISPOSABLE loopback MySQL server.
# The harness refuses any non-loopback host and any target sharing a server
# with DATABASE_URL, and creates/drops its own per-run database.
# TEST_DATABASE_URL=mysql://root@127.0.0.1:3306/
